<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

                <!-- 顶部区：左上 模式切换（保存 / 传输），右上 品牌块（整体右对齐，尺寸与竖向排列与原样一致） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="horizontal"
            android:gravity="top"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top">

                <LinearLayout
                    android:id="@+id/mode_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tab_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/mode_save"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/mode_active"
                        android:letterSpacing="0.06"
                        android:clickable="true"
                        android:focusable="true" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tab_transfer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/mode_transfer"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/mode_inactive"
                        android:letterSpacing="0.06"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <View
                    android:id="@+id/mode_indicator"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom|start"
                    android:background="@color/mode_active" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_icon_frame"
                    android:clipToOutline="true"
                    android:foreground="@drawable/fg_icon_frame_stroke"
                    android:padding="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@mipmap/ic_launcher"
                        android:scaleType="fitXY"
                        android:contentDescription="@string/app_name" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_dark"
                    android:gravity="end"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/text_on_dark_sub"
                    android:gravity="end"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 功能卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_margin="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/link_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/et_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_link"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:maxLines="6"
                    android:gravity="top|start"
                    android:paddingStart="14dp"
                    android:paddingEnd="72dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:importantForAutofill="no"
                    android:background="@drawable/bg_input" />

                <Button
                    android:id="@+id/btn_paste"
                    android:layout_width="56dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="粘贴"
                    android:textSize="12sp"
                    android:textColor="@color/accent_cyan"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="56dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="×"
                    android:textSize="22sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null" />
            </FrameLayout>

            <Button
                android:id="@+id/btn_parse"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_parse"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:elevation="6dp"
                android:letterSpacing="0.04"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_download"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_save"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:letterSpacing="0.04"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cb_burn_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/burn_title_option"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:checked="false"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:visibility="gone"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="6dp" />

            <CheckBox
                android:id="@+id/cb_apply_cover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apply_cover_option"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:checked="false"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:visibility="gone"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_stitch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_stitch_video"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:letterSpacing="0.04"
                android:visibility="gone"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_save_music"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_save_music"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:letterSpacing="0.04"
                android:visibility="gone"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/photo_selection_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_photo_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <Button
                        android:id="@+id/btn_select_all"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/btn_select_all"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_btn_secondary"
                        android:stateListAnimator="@null" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_select_none"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/btn_select_none"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_btn_secondary"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cb_include_stickers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/include_stickers"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_cyan"
                    android:checked="true"
                    android:paddingTop="2dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/photo_checkbox_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progressTint="@color/primary"
                android:progressBackgroundTint="@color/progress_bg"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 最近保存 -->
        <LinearLayout
            android:id="@+id/recent_history_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/recent_history_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recent_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_recent_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recent_empty_summary"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recent_history_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_recent_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_empty"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:id="@+id/recent_history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <FrameLayout
                    android:id="@+id/recent_history_expanded_clip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/recent_history_expanded_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/recent_history_peek"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/recent_history_peek_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_history_fade"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_recent_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_retention_note"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 使用说明卡片 -->
        <LinearLayout
            android:id="@+id/usage_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/usage_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_usage_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/usage_body"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="6dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btn_usage_expand"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="@string/usage_expand"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="6dp" />

            <LinearLayout
                android:id="@+id/usage_supplement_clip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="true"
                android:clipToPadding="true">

                <View
                    android:id="@+id/usage_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_notice_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notice_body"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_transfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_margin="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_pc_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_pc_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_pc_status_idle"
                    android:textSize="13sp"
                    android:textColor="@color/accent_cyan"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:id="@+id/pc_connect_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <EditText
                    android:id="@+id/et_pc_addr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/transfer_addr_hint"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:importantForAutofill="no"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btn_pc_find"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/transfer_find"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_btn_secondary"
                        android:stateListAnimator="@null"
                        android:letterSpacing="0.04" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_pc_connect"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/transfer_connect_now"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_btn_primary"
                        android:stateListAnimator="@null"
                        android:letterSpacing="0.04" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_pc_hint"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="10dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/transfer_media_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btn_transfer_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/transfer_refresh"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_cyan"
                        android:background="@android:color/transparent"
                        android:stateListAnimator="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btn_transfer_all"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/transfer_select_all"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_btn_secondary"
                        android:stateListAnimator="@null" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_transfer_none"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/transfer_select_none"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_btn_secondary"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <!-- 传输按钮放在列表上方：列表可能很长，按钮沉底会逼用户往下翻 -->
                <Button
                    android:id="@+id/btn_transfer_start"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/transfer_start"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_btn_primary"
                    android:stateListAnimator="@null"
                    android:elevation="6dp"
                    android:letterSpacing="0.04"
                    android:layout_marginTop="12dp" />

                <ProgressBar
                    android:id="@+id/transfer_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/progress_bg"
                    android:visibility="gone"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tv_transfer_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_transfer_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_list_empty"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp" />

                <LinearLayout
                    android:id="@+id/transfer_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 默认只渲染最新的若干项，其余折叠（与「最近保存」记录同一思路） -->
                <Button
                    android:id="@+id/btn_transfer_expand"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
