# Copy these values into environment variables before building a release APK.
# Never commit the real keystore or its passwords into source control.
VIDEO_SAVER_KEYSTORE=C:/private/path/release-signing.jks
VIDEO_SAVER_STORE_PASSWORD=replace_me
VIDEO_SAVER_KEY_ALIAS=video_saver_release
VIDEO_SAVER_KEY_PASSWORD=replace_me
